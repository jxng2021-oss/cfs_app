{
  "name": "cfs-admissions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "npm run build:web && node --env-file-if-exists=.env --watch --import tsx apps/api/app/server.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "migrate": "node --env-file-if-exists=.env dist/api/cli.js migrate",
    "bootstrap-admin": "node --env-file-if-exists=.env dist/api/cli.js bootstrap-admin",
    "seed": "node --env-file-if-exists=.env dist/api/cli.js seed"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@fontsource-variable/inter": "^5.3.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^1.80.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.1"
  }
}
