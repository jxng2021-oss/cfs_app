# Local values match the development-only Postgres Compose service.
DATABASE_URL=postgres://admissions:local-postgres-only@localhost:55432/admissions
APP_ORIGIN=http://localhost:3000
PORT=3000
SESSION_PEPPER=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
TRUST_PROXY=false
COOKIE_SECURE=false
# SECRET_ID optionally loads DATABASE_URL and SESSION_PEPPER from Secrets Manager.
# Shown on Infrastructure Status. On EC2 these are written by the launch template; leave unset locally.
# INSTANCE_ID=
# AVAILABILITY_ZONE=
# AWS_REGION=
# INSTANCE_METADATA=imds   (optional: look up instance ID and zone via IMDSv2 at startup)
APP_ENVIRONMENT=development
# APP_VERSION=             (defaults to package.json version)
# Default for the Settings → Student admin number field.
STUDENT_ADMIN_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_PASSWORD=
# DEMO_CLOCK_ISO can pin relative demo data to an ISO 8601 timestamp when seeding.
