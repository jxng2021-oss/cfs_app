# Local values match the development-only Postgres Compose service.
DATABASE_URL=postgres://lms:local-postgres-only@localhost:55432/lms
APP_ORIGIN=http://localhost:3000
PORT=3000
SESSION_PEPPER=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
TRUST_PROXY=false
COOKIE_SECURE=false
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
# S3_BUCKET is required with STORAGE_DRIVER=s3. AWS_REGION uses the SDK chain.
# SECRET_ID optionally loads DATABASE_URL and SESSION_PEPPER from Secrets Manager.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_PASSWORD=
# DEMO_CLOCK_ISO can pin relative fixtures to an ISO 8601 timestamp when seeding.
